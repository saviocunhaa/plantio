# Set private values in the ignored .env.local, never NEXT_PUBLIC_*.
DATABASE_URL=
# Optional direct connection for migration providers that require it.
DATABASE_URL_UNPOOLED=
LOG_LEVEL=info
# Optional local Ollama assistant configuration (falls back to curated local rules when offline).
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma4
